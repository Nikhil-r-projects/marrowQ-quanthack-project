# MarrowQ configuration. Copy to .env (never commit .env).

# --- Storage --------------------------------------------------------------
# SQLite database. Keep it on the native filesystem (e.g. the WSL home), not under /mnt/c.
# MARROWQ_DB_PATH=~/.marrowq/marrowq.db
# MARROWQ_DATA_DIR=backend/app/data
# MARROWQ_ARTIFACTS_DIR=backend/app/artifacts

# --- IBM Quantum Platform (quantum.cloud.ibm.com) -------------------------
# API key from the dashboard, and the CRN of your instance (Instances page).
QISKIT_IBM_TOKEN=
QISKIT_IBM_INSTANCE=
IBM_CHANNEL=ibm_quantum_platform
# Refuse any hardware submission estimated above this many QPU seconds (Open Plan: 600 s per 28 days).
IBM_MAX_SECONDS_PER_RUN=60

# --- Claude (Anthropic API) ---------------------------------------------
# Drafts the clinical review reports from computed results. Server-side only.
ANTHROPIC_API_KEY=

# --- Worker ---------------------------------------------------------------
MARROWQ_WORKER_POLL_SECONDS=1
