# MarrowQ Environment Configuration. Copy to .env (never commit .env).

PORT=8000
HOST=127.0.0.1
DEBUG=False

# --- IBM Quantum Compute Service Configuration ----------------------------
# Read from environment variables according to official Qiskit Runtime docs:
IBM_QUANTUM_API_KEY=your_ibm_quantum_api_key_here
IBM_QUANTUM_CHANNEL=ibm_quantum_platform
IBM_QUANTUM_BACKEND=ibm_fez
# Instance identifier (CRN or hub/group/project) if required by your account plan; leave blank for open plan:
IBM_QUANTUM_INSTANCE=auto
IBM_MAX_SECONDS_PER_RUN=60

# Backwards-compatible aliases
QISKIT_IBM_TOKEN=
QISKIT_IBM_INSTANCE=

# --- Storage & Compute ----------------------------------------------------
# MARROWQ_DB_PATH=backend/app/marrowq.db
# MARROWQ_DATA_DIR=backend/app/data
# MARROWQ_ARTIFACTS_DIR=backend/app/artifacts
MARROWQ_WORKER_POLL_SECONDS=1

# --- Optional Services ----------------------------------------------------
ELEVENLABS_API_KEY=your_elevenlabs_key_here
